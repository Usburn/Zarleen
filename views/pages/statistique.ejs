<%- include('partials/header.ejs') %>




<main class="newPost" id="donnee">

  <%
    function formatDate(date) {
      if (!date) return "0";
      return new Date(date).toLocaleString('fr-FR', { timeZone: 'UTC' });
    }
  %>

  <% if (locals.result) { %>

    <p>
        La quantité totale bue aujourd'hui est : <%= result.aujourdHui %> ml, à cette heure : <%= formatDate(result.lastMilk) %>
    </p>

    <p>
        La quantité totale bue hier est :
        <%= result.hier %> ml
    </p>

    <p>
        La quantité totale de lait maternel tiré aujourd'hui est :
        <%= result.quantiteLaitAujourdHui %> ml
    </p>

    <p>
        Nombre d'urines aujourd'hui :
        <%= result.urineAujourdHui %>
    </p>

    <p style="color: red;">
        Dernière selle:
        <%= formatDate(result.lastSelle) %>
    </p>

    <p>
        Nombre de selles aujourd'hui :
        <%= result.selleAujourdHui %>
    </p>

<% } %>

     <h1>Formulaire de collecte de données</h1>

      <form action="/statistique" method="post" class="form_post">

            <div class="field">
                <label for="date">Date-heure:</label>
                <input type="datetime-local" id="date" name="date" required>
            </div>

            <div class="field">
                <label for="quantite">Quantité:</label>
               <input type="number" name="quantite" id="quantite" min="0" step="any">
            </div>

            <div class="field">
                <label for="selle">Selle:</label>
                <select name="selle" id="selle">
                    <option value="">Selectionner</option>
                    <option value="oui">oui</option>
                    <option value="non">non</option>
                </select>
            </div>

            <div class="field">
                <label for="urine">Urine:</label>
                <select name="urine" id="urine">
                    <option value="">Selectionner</option>
                    <option value="oui">oui</option>
                    <option value="non">non</option>
                </select>
            </div>

            <div class="field">
                <label for="quantite_lait">Lait maternel:</label>
               <input type="number" name="quantite_lait" id="quantite_lait" min="0" step="any">
            </div>

            <div class="field">
                <label for="poids">Poids:</label>
               <input type="number" name="poids" id="poids" min="0" step="any">
            </div>

            <button type="submit">Envoyer</button>

        </form>
</main>

<script src="/js/script.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const now = new Date();
    const year = now.getFullYear();
    const month = String(now.getMonth() + 1).padStart(2, '0');
    const day = String(now.getDate()).padStart(2, '0');
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const localDatetime = `${year}-${month}-${day}T${hours}:${minutes}`;
    document.getElementById('date').value = localDatetime;
  });
</script>
<%- include('partials/footer') %>